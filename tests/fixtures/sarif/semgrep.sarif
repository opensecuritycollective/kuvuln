{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "1.182.0",
          "rules": [
            {
              "id": "python.lang.security.audit.exec-detected.exec-detected",
              "name": "exec-detected",
              "shortDescription": {"text": "Python code execution with eval/exec"},
              "helpUri": "https://semgrep.dev/r/python.lang.security.audit.exec-detected",
              "defaultConfiguration": {"level": "warning"},
              "properties": {"tags": ["security", "cwe-95"]}
            }
          ]
        }
      },
      "results": [
        {
          "ruleIndex": 0,
          "level": "warning",
          "message": {"text": "Detected eval on user-controlled input."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app.py"},
                "region": {"startLine": 42}
              }
            }
          ]
        }
      ]
    }
  ]
}
